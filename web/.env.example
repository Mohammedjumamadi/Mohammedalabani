APP_NAME="AI Media Verifier"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

# اللغة الافتراضية للمنصة: ar أو en
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# قاعدة البيانات (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_media_verifier
DB_USERNAME=aimv
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# أطول من مهلة مهمة التحليل (900 ثانية) حتى لا تُعاد مهمة ما زالت تعمل
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@aimediaverifier.test"
MAIL_FROM_NAME="${APP_NAME}"

# خدمة الذكاء الاصطناعي (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8001
# مفتاح سري مشترك بين Laravel وخدمة الذكاء الاصطناعي (ولّده بـ: php -r "echo bin2hex(random_bytes(32));")
AI_SERVICE_KEY=
AI_SERVICE_TIMEOUT=300

# الحدود الافتراضية (يعدّلها المدير من لوحة التحكم بعد التثبيت)
UPLOAD_MAX_MB=100
RETENTION_DAYS=30

VITE_APP_NAME="${APP_NAME}"
